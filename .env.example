# Copy to .env and adjust. Everything runs locally.

# Which decision-model provider to use: ollama | mock
#   mock = plausible random answers, no model needed (good for building and testing)
DECISION_PROVIDER=ollama

# Local Ollama server (0.35+). Only local / LAN addresses are accepted; ollama.com is refused.
OLLAMA_URL=http://localhost:11434

# Default decision model (the Balanced preset). Can be switched live in settings.
#   Lite:     laya  (English)  or  laya:322m-multilingual-bf16  (other languages)
#   Balanced: tev1
#   Best:     nimble
DECISION_MODEL=tev1

# Passed to Ollama as keep_alive so the model stays loaded between entries.
OLLAMA_KEEP_ALIVE=30m

# How long to wait for one answer (ms). Big models on a CPU can take minutes.
DECISION_TIMEOUT_MS=300000

# Mote's own server. It binds to this machine only.
MOTE_HOST=127.0.0.1
MOTE_PORT=5174

# Where the journal lives (a single SQLite file).
MOTE_DB_PATH=data/mote.sqlite

# Debug panel (visual sliders, fast-forward time, rebirth). On by default outside production.
MOTE_DEBUG=true
