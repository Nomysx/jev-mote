{
  "$comment": "Decision-model catalog, checked against each model's page at ollama.com/library/<name> in November 2026. maxStateTokens is Mote's budget for the state object (the questions need room too); it is derived from each model's documented context limit. minOllama is the version stated on the model page, or the /v1/systemone API minimum (0.35.0) where the page states none; at runtime Mote also enforces the `requires` version Ollama reports for the installed package.",
  "defaults": {
    "maxStateTokens": 1500,
    "maxRecentMessages": 8,
    "recentMessageMaxChars": 600,
    "minOllama": "0.35.0"
  },
  "presets": [
    {
      "id": "lite",
      "label": "Lite",
      "hardware": "Old laptops, CPU only",
      "models": [
        {
          "model": "laya",
          "when": "English"
        },
        {
          "model": "laya:322m-multilingual-bf16",
          "when": "Other languages"
        }
      ]
    },
    {
      "id": "balanced",
      "label": "Balanced",
      "hardware": "16 GB RAM (default)",
      "models": [
        {
          "model": "tev1",
          "when": "Default"
        }
      ]
    },
    {
      "id": "best",
      "label": "Best",
      "hardware": "32 GB+ RAM or a good GPU",
      "models": [
        {
          "model": "nimble",
          "when": "Highest accuracy"
        }
      ]
    }
  ],
